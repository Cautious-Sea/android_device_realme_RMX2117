<?xml version="1.0" encoding="utf-8"?>
<!--
    Kernel Manager config — MediaTek Dimensity 800U (MT6853)
    Realme Narzo 30 Pro 5G (RMX2117)

      policy0 (cpu0-5, 6 cores - Cortex-A55)
        500 MHz - 2000 MHz (2.0 GHz)

      policy6 (cpu6-7, 2 cores - Cortex-A76)
        725 MHz - 2400 MHz (2.4 GHz)
-->
<kernel-manager>

    <cpu
        id="little"
        group="Little CPU"
        minId="axion_min_freq"
        maxId="axion_max_freq"
        governorId="little_cpu_governor"
        minNode="/sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq"
        maxNode="/sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq"
        availablePath="/sys/devices/system/cpu/cpufreq/policy0/scaling_available_frequencies"
        governorNode="/sys/devices/system/cpu/cpufreq/policy0/scaling_governor"
        governorAvailablePath="/sys/devices/system/cpu/cpufreq/policy0/scaling_available_governors" />

    <cpu
        id="big"
        group="Big CPU"
        minId="axion_min_freq_big"
        maxId="axion_max_freq_big"
        governorId="big_cpu_governor"
        minNode="/sys/devices/system/cpu/cpufreq/policy6/scaling_min_freq"
        maxNode="/sys/devices/system/cpu/cpufreq/policy6/scaling_max_freq"
        availablePath="/sys/devices/system/cpu/cpufreq/policy6/scaling_available_frequencies"
        governorNode="/sys/devices/system/cpu/cpufreq/policy6/scaling_governor"
        governorAvailablePath="/sys/devices/system/cpu/cpufreq/policy6/scaling_available_governors" />

</kernel-manager>
